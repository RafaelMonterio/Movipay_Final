# URL da API Express única usada pelo app.
#
# Celular físico na mesma rede Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1
#
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
#
# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
#
# API publicada:
# EXPO_PUBLIC_API_URL=https://api.seudominio.com/api/v1
#
# Troque o endereço pelo IP/URL real antes de abrir pelo Expo Go.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api/v1
