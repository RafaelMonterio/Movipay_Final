{
  "name": "movipay-api",
  "version": "0.9.1",
  "private": true,
  "description": "API real do MoviPay (Node + Express + PostgreSQL) — usada pelo site e pelo app mobile",
  "main": "src/aplicativo.js",
  "scripts": {
    "start": "node src/aplicativo.js",
    "dev": "nodemon src/aplicativo.js",
    "db:migrate": "node src/banco/migrar.js",
    "db:seed": "node src/banco/migrar.js --seed",
    "db:reset": "node src/banco/migrar.js --reset --seed",
    "test:e2e": "node scripts/teste-e2e.js",
    "dev:tunnel": "node scripts/tunel-desenvolvimento.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
