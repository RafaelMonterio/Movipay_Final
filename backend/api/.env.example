##############################################################
# MoviPay — backend
# Copie para .env  (cp .env.example .env) e preencha.
# NUNCA versione o .env com valores reais.
##############################################################

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movipay
DB_USER=movipay
DB_PASSWORD=movipay_secret
DB_SSL=false
DB_POOL_MAX=10

# Supabase Cloud: copie a URL em Dashboard > Connect.
# Para um backend persistente, prefira Session pooler (porta 5432).
# Se DATABASE_URL existir, ela tem prioridade sobre DB_HOST/DB_PORT/etc.
DATABASE_URL=
SUPABASE_DB_URL=

# ------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------
# Troque por uma string longa e aleatória em produção.
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=30d

CORS_ORIGIN=*

# ------------------------------------------------------------
# URLs públicas
# ------------------------------------------------------------
# PUBLIC_API_URL é OBRIGATÓRIA para o webhook de pagamento funcionar:
# é o endereço que o gateway vai chamar de fora. Em desenvolvimento,
# use um túnel (ex.: `npx localtunnel --port 3000` ou ngrok) e cole a
# URL https gerada aqui.
PUBLIC_API_URL=
PUBLIC_APP_URL=

# ------------------------------------------------------------
# Upload de arquivos (fotos e vídeos dos Shorts, avatares)
# ------------------------------------------------------------
# Pasta onde os arquivos ficam. Se não informar, usa backend/uploads.
UPLOAD_DIR=
MAX_IMAGE_MB=12
MAX_VIDEO_MB=120

# ------------------------------------------------------------
# PAGAMENTOS
# ------------------------------------------------------------
# Provedor ativo: mercadopago (recomendado) ou manual_pix.
PAYMENT_PROVIDER=mercadopago

# --- Mercado Pago -------------------------------------------
# Onde pegar: mercadopago.com.br/developers > Suas integrações >
# (sua aplicação) > Credenciais.
#   • Credenciais de TESTE (começam com TEST-) para sandbox
#   • Credenciais de PRODUÇÃO (APP_USR-) para valer
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações > (aplicação) > Webhooks > "Chave secreta".
# Configure a URL do webhook como:
#   {PUBLIC_API_URL}/api/v1/payments/webhook/mercadopago
# e, para assinatura recorrente:
#   {PUBLIC_API_URL}/api/v1/plans/webhook/mercadopago-subscription
MERCADOPAGO_WEBHOOK_SECRET=

# --- Pix na chave própria (provedor manual_pix) --------------
# Chave Pix da empresa, exatamente como foi informada. O backend usa
# este valor literalmente para montar o BR Code — nenhum dígito é
# alterado. ATENÇÃO: confirme com o seu banco/PSP que esta chave está
# cadastrada e de que tipo ela é (CPF, telefone, e-mail ou aleatória)
# antes de usar em produção; o sistema não tem como verificar isso.
PIX_KEY=47079033802
PIX_MERCHANT_NAME=MOVIPAY
PIX_MERCHANT_CITY=RIBEIRAO PIRES

# Token administrativo para confirmar manualmente um Pix recebido
# (só usado quando PAYMENT_PROVIDER=manual_pix). O aplicativo NÃO
# conhece este token — por isso ele não consegue aprovar pagamento.
# Enviado no cabeçalho `x-admin-token`.
ADMIN_CONFIRM_TOKEN=

# ------------------------------------------------------------
# Validação externa de CPF (OPCIONAL)
# ------------------------------------------------------------
# A validação dos dígitos verificadores é local e sempre ativa — isto
# aqui é só a consulta de SITUAÇÃO do documento, que exige um provedor
# contratado. Não há provedor embutido de propósito: preencha com o que
# você contratar (Serpro/Datavalid, Infosimples, etc.).
# Enquanto CPF_VALIDATION_ENABLED não for "true", nada muda no cadastro.
CPF_VALIDATION_ENABLED=false
CPF_VALIDATION_API_URL=
CPF_VALIDATION_API_KEY=
CPF_VALIDATION_AUTH_HEADER=Authorization
CPF_VALIDATION_AUTH_PREFIX=Bearer
# Caminho e valor esperados na resposta do provedor para considerar
# o CPF regular. Ex.: OK_PATH=data.situacao  OK_VALUE=REGULAR
CPF_VALIDATION_OK_PATH=
CPF_VALIDATION_OK_VALUE=
